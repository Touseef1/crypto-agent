{
  "name": "cryptobot",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cryptobot/web",
    "build": "npm run build -w @cryptobot/web",
    "typecheck": "npm run typecheck -w @cryptobot/web",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "test": "vitest run",
    "paper:monitor": "node --env-file=.env scripts/paper-monitor.mjs"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "decimal.js": "^10.6.0",
    "zod": "^4.1.0",
    "bcryptjs": "^3.0.0"
  }
}
